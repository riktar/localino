{
  "name": "localino",
  "version": "0.1.0",
  "private": true,
  "description": "A compact desktop panel for coding agents and local notes",
  "author": "Localino",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run build:native",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run build:common && npm run build:native",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "test": "npm run test:unit && npm run build && node --test --test-concurrency=1 tests/session-contracts.test.mjs tests/desktop.test.mjs tests/development.test.mjs tests/quotas-ui.test.mjs tests/dashboard.test.mjs tests/navigation.test.mjs tests/clipboard.test.mjs tests/shortcuts.test.mjs tests/capture.test.mjs tests/agents.test.mjs tests/local-history.test.mjs tests/pi-history.test.mjs tests/opencode-history.test.mjs tests/bridge.test.mjs tests/panel.test.mjs tests/panel-clipboard.test.mjs tests/shortcut-routing.test.mjs tests/appearance.test.mjs",
    "test:packaged": "node --test tests/packaged.test.mjs",
    "check": "npm run lint && npm test",
    "test:unit": "npm run build:native && node --import tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:dashboard": "npm run build && node --import tsx --test tests/dashboard-live.test.ts",
    "test:dashboard:packaged": "node --import tsx --test tests/dashboard-packaged.test.ts",
    "test:rates": "npm run build && node --import tsx --test tests/rates-live.test.ts",
    "test:account": "npm run build && node --import tsx --test tests/account-live.test.ts",
    "build:native": "node scripts/build-native.mjs",
    "build:common": "npm run typecheck && electron-vite build",
    "build:mac": "node scripts/build-mac.mjs",
    "build:mac:arm64": "node scripts/build-mac.mjs arm64",
    "build:mac:x64": "node scripts/build-mac.mjs x64",
    "test:capture:native": "node --test tests/native-capture.test.mjs"
  },
  "build": {
    "appId": "app.localino.desktop",
    "productName": "Localino",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*",
      "!out/native/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "out/native",
        "to": "native",
        "filter": [
          "Localino.Capture*",
          "Localino.StatusLine*"
        ]
      }
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/native/Localino.Capture",
        "Contents/Resources/native/Localino.StatusLine"
      ]
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  }
}
